---
import favIcon from '~/assets/favicons/favicon.ico';
import favIconSvg from '~/assets/favicons/favicon.svg';
import appleTouchIcon from '~/assets/favicons/apple-touch-icon.png';
---

<link rel="shortcut icon" href={`${favIcon}?v=2`} />
<link rel="icon" type="image/svg+xml" href={`${favIconSvg.src}?v=2`} />
<link rel="mask-icon" href={`${favIconSvg.src}?v=2`} color="#3B5998" />
<link rel="apple-touch-icon" sizes="180x180" href={`${appleTouchIcon.src}?v=2`} />