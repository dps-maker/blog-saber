---
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    /* Cores Institucionais */
    --aw-color-primary: rgb(59 89 152);     /* #3B5998 */
    --aw-color-secondary: rgb(9 139 24);    /* #098B18 */
    --aw-color-accent: rgb(59 89 152);

    /* Tipografia: Grafite Elegante em vez de Preto Puro */
    --aw-color-text-heading: rgb(30 41 59);  /* #1E293B */
    --aw-color-text-default: rgb(51 65 85);  /* #334155 */
    --aw-color-text-muted: rgb(100 116 139); /* #64748B */
    --aw-color-bg-page: rgb(255 255 255);
    --aw-color-bg-page-dark: rgb(15 23 42);
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(59 89 152);
    --aw-color-secondary: rgb(9 139 24);
    --aw-color-accent: rgb(59 89 152);

    --aw-color-text-heading: rgb(248 250 252);
    --aw-color-text-default: rgb(226 232 240);
    --aw-color-text-muted: rgb(148 163 184);
    --aw-color-bg-page: rgb(15 23 42);
  }

  /* Links com cor principal azul institucional */
  a {
    color: #3B5998;
  }

  a:hover {
    color: #2D4373;
  }
</style>