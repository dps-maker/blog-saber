---
import { getPermalink } from '~/utils/permalinks';
import type { Post } from '~/types';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const permalink = getPermalink(post.permalink, 'post');
---

<article class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col justify-between h-full">
  <div class="flex flex-col justify-between flex-1">
    <header>
      <h2 class="text-lg sm:text-xl font-bold leading-snug mb-2 font-heading dark:text-slate-200">
        <a href={permalink} class="hover:text-primary dark:hover:text-blue-400 transition duration-200">
          {post.title}
        </a>
      </h2>
    </header>
  </div>
</article>