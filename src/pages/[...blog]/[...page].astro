---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/blog/Headline.astro';
import { fetchPosts } from '~/utils/blog';
import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

// Busca todos os posts para passar como fonte de dados ao navegador
const allPosts = await fetchPosts();

const postsPayload = allPosts.map((p) => ({
  title: p.title,
  slug: p.slug || p.permalink,
  excerpt: p.excerpt || '',
  category: p.category?.title || 'Leituras essenciais',
}));

// Posts padrão renderizados caso o JavaScript esteja desativado
const initialFeatured = allPosts[0];
const initialGrid = allPosts.slice(1, 4);

const metadata = {
  title: `Blog da Imobiliária Saber${currentPage > 1 ? ` — Página ${currentPage}` : ''}`,
  description: 'Guias e análises exclusivas do mercado imobiliário de Indaiatuba',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: { type: 'blog' },
};
---

<Layout metadata={metadata}>
  <section class="px-3 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
    <div class="text-center mb-8">
      <a href="https://saber.imb.br/" class="text-sm font-medium text-primary hover:opacity-80 transition-opacity">
        ← Sair do blog
      </a>
    </div>

    <Headline
      subtitle="Guias estratégicos, análises de mercado e oportunidades em Indaiatuba"
      classes={{
        title: "whitespace-nowrap font-bold tracking-tight title-single-line",
      }}
    >
      <span class="whitespace-nowrap inline-block max-w-full">Blog da Imobiliária Saber</span>
    </Headline>

    {/* DESTAQUE PRINCIPAL (HERO) */}
    {currentPage === 1 && initialFeatured && (
      <div class="mb-16 pb-12 border-b border-gray-200 dark:border-slate-800">
        <div class="items-center bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 shadow-sm">
          <div class="flex flex-col justify-center">
            <span class="text-xs font-bold uppercase tracking-wider mb-2" style="color: #098B18;">
              Leitura Interessante
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold font-heading mb-4 dark:text-slate-100 leading-tight">
              <a
                id="featured-title-link"
                class="hover:text-primary dark:hover:text-blue-400 transition duration-200"
                href={`/blog/${initialFeatured.slug || initialFeatured.permalink}`}
              >
                {initialFeatured.title}
              </a>
            </h2>
            {initialFeatured.excerpt && (
              <p id="featured-excerpt" class="text-muted dark:text-slate-400 text-base sm:text-lg mb-6 line-clamp-3">
                {initialFeatured.excerpt}
              </p>
            )}
            <div>
              <a
                id="featured-btn-link"
                href={`/blog/${initialFeatured.slug || initialFeatured.permalink}`}
                class="btn btn-primary px-5 py-2.5 text-sm font-semibold"
              >
                Iniciar Análise →
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

    {/* GRADE DE 3 POSTS SECUNDÁRIOS */}
    {currentPage === 1 && (
      <div class="mb-16">
        <div class="flex justify-between items-center mb-6 border-b border-gray-200 dark:border-slate-800 pb-2">
          <h3 class="text-2xl font-bold font-heading dark:text-slate-200">Leituras essenciais</h3>
        </div>
        <div class="grid gap-6 sm:grid-gap-8 md:grid-cols-2 lg:grid-cols-3" id="dynamic-grid-slot">
          {initialGrid.map((post) => (
            <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col justify-between">
              <article class="flex flex-col h-full">
                <div class="flex flex-col justify-between flex-1">
                  <header>
                    <h2 class="text-lg sm:text-xl font-bold leading-snug mb-2 font-heading dark:text-slate-200">
                      <a
                        href={`/blog/${post.slug || post.permalink}`}
                        class="hover:text-primary dark:hover:text-blue-400 transition duration-200"
                      >
                        {post.title}
                      </a>
                    </h2>
                  </header>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>
    )}
  </section>

  <style>
    .title-single-line {
      font-size: clamp(1.1rem, 5.2vw, 2.75rem);
      line-height: 1.2;
    }
  </style>

  {/* ROTAÇÃO ALEATÓRIA NO CLIENTE (A CADA F5 / CARREGAMENTO) */}
  <script is:inline define:vars={{ postsPayload }}>
    function shuffleAndRenderPosts() {
      if (!Array.isArray(postsPayload) || postsPayload.length < 4) return;

      // Embaralhamento Fisher-Yates
      const items = [...postsPayload];
      for (let i = items.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [items[i], items[j]] = [items[j], items[i]];
      }

      // 1. Atualiza o Post de Destaque
      const featured = items[0];
      const featuredUrl = `/blog/${featured.slug}`;
      const titleLink = document.getElementById('featured-title-link');
      const excerptEl = document.getElementById('featured-excerpt');
      const btnLink = document.getElementById('featured-btn-link');

      if (titleLink) {
        titleLink.textContent = featured.title;
        titleLink.setAttribute('href', featuredUrl);
      }
      if (excerptEl) {
        excerptEl.textContent = featured.excerpt;
      }
      if (btnLink) {
        btnLink.setAttribute('href', featuredUrl);
      }

      // 2. Atualiza a Grade com os próximos 3 Posts
      const gridSlot = document.getElementById('dynamic-grid-slot');
      if (gridSlot) {
        const selectedThree = items.slice(1, 4);
        gridSlot.innerHTML = selectedThree
          .map((post) => {
            const url = `/blog/${post.slug}`;
            return `
              <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col justify-between">
                <article class="flex flex-col h-full">
                  <div class="flex flex-col justify-between flex-1">
                    <header>
                      <h2 class="text-lg sm:text-xl font-bold leading-snug mb-2 font-heading dark:text-slate-200">
                        <a href="${url}" class="hover:text-primary dark:hover:text-blue-400 transition duration-200">
                          ${post.title}
                        </a>
                      </h2>
                    </header>
                  </div>
                </article>
              </div>
            `;
          })
          .join('');
      }
    }

    shuffleAndRenderPosts();
    document.addEventListener('astro:page-load', shuffleAndRenderPosts);
  </script>
</Layout>