---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import Item from '~/components/blog/ListItem.astro';

import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async () => {
  return [
    {
      params: {
        blog: undefined,
      },
    },
  ];
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

// Carrega todas as postagens no build para gerar os elementos HTML
const allPosts = await fetchPosts();

const metadata = {
  title: 'Inteligência Imobiliária',
  description: 'Guias estratégicos, análises de mercado e oportunidades de investimento.',
  robots: {
    index: true,
    follow: true,
  },
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 max-w-6xl mx-auto">
    <div class="mb-8 text-center">
      <a href="https://saber.imb.br/" class="text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors">
        ← Voltar para o Início
      </a>
    </div>

    <header class="text-center mb-8 md:mb-16 max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        Inteligência Imobiliária
      </h1>
      <div class="mt-2 md:mt-3 text-xl text-gray-500 dark:text-slate-400 font-medium">
        Guias estratégicos, análises de mercado e oportunidades de investimento.
      </div>
    </header>

    {/* 1. DESTAQUE PRINCIPAL: Itens gerados no build com classe 'hidden' */}
    <div class="mb-16 pb-12 border-b border-gray-200 dark:border-slate-800" id="featured-container">
      {allPosts.map((post, index) => (
        <div
          class="featured-post-item hidden grid md:grid-cols-2 gap-8 items-center bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 shadow-sm"
          data-post-index={index}
        >
          <div class="flex flex-col justify-center">
            <span class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider mb-2">
              Leitura Obrigatória
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold font-heading leading-tight mb-4 dark:text-slate-100">
              <a
                href={getPermalink(post.permalink, 'post')}
                class="hover:text-primary dark:hover:text-blue-400 transition duration-200"
              >
                {post.title}
              </a>
            </h2>
            <div>
              <a
                href={getPermalink(post.permalink, 'post')}
                class="btn btn-primary text-sm font-semibold px-5 py-2.5"
              >
                Iniciar Análise →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* 2. GRADE DE 3 POSTS: Itens secundários também gerados com classe 'hidden' */}
    <div class="mb-16">
      <div class="flex justify-between items-center mb-6 pb-2 border-b border-gray-200 dark:border-slate-800">
        <h3 class="text-2xl font-bold font-heading dark:text-slate-200">Insights Estratégicos</h3>
      </div>

      <div class="grid gap-6 sm:grid-gap-8 md:grid-cols-2 lg:grid-cols-3" id="grid-container">
        {allPosts.map((post, index) => (
          <div
            class="grid-post-item hidden bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col justify-between"
            data-post-index={index}
          >
            <Item post={post} />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* SCRIPT EXECUTADO NO NAVEGADOR: Embaralha e exibe 4 posts únicos a cada visita/F5 */}
  <script is:inline>
    function renderDynamicPosts() {
      const featuredElements = Array.from(document.querySelectorAll('.featured-post-item'));
      const gridElements = Array.from(document.querySelectorAll('.grid-post-item'));
      const total = featuredElements.length;

      if (total === 0) return;

      // Oculta todos os cards para resetar em caso de navegação via View Transitions
      featuredElements.forEach((el) => el.classList.add('hidden'));
      gridElements.forEach((el) => el.classList.add('hidden'));

      // Algoritmo de Fisher-Yates para embaralhar os índices sem repetição
      const pool = Array.from({ length: total }, (_, i) => i);
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }

      // Índice sorteado para o Destaque
      const featuredIdx = pool[0];
      if (featuredElements[featuredIdx]) {
        featuredElements[featuredIdx].classList.remove('hidden');
      }

      // 3 índices únicos sorteados para a Grade (pool[1], pool[2], pool[3])
      const gridIndices = pool.slice(1, 4);
      gridIndices.forEach((idx) => {
        if (gridElements[idx]) {
          gridElements[idx].classList.remove('hidden');
        }
      });
    }

    // Executa no carregamento normal e em transições de página do Astro
    document.addEventListener('DOMContentLoaded', renderDynamicPosts);
    document.addEventListener('astro:page-load', renderDynamicPosts);
  </script>
</Layout>