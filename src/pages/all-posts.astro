---
import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/ui/Headline.astro';
import { getCollection } from 'astro:content';

const metadata = {
  title: 'Índice de Artigos',
  description: 'Navegue por todas as nossas publicações em ordem alfabética.',
};

const allPosts = await getCollection('post');

const sortedPosts = allPosts.sort((a, b) => {
  return a.data.title.localeCompare(b.data.title, 'pt-BR', { sensitivity: 'base' });
});
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline
      title="Índice de Artigos (A - Z)"
      subtitle="Encontre todos os guias, artigos e análises imobiliárias em ordem alfabética."
    />

    <div class="mt-8 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 shadow-sm">
      <ul class="divide-y divide-gray-100 dark:divide-gray-800">
        {
          sortedPosts.map((post) => (
            <li class="py-3.5 first:pt-0 last:pb-0">
              <a
                href={`/blog/${post.id}`}
                class="text-base sm:text-lg font-medium text-default hover:text-green-600 dark:hover:text-green-400 flex items-center justify-between group transition-colors"
              >
                <span class="pr-4">{post.data.title}</span>
                <span class="text-xs font-semibold text-muted opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">
                  Ler artigo &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>